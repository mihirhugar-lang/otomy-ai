<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.crusherops.erp-sync-15min</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/apple/codex/CRUSHER/apps/CrusherOps/scripts/erp_sync_15min.command</string>
    </array>

    <key>StartInterval</key>
    <integer>900</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/apple/Library/Logs/CrusherOps/erp_sync_15min_launchd_out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/apple/Library/Logs/CrusherOps/erp_sync_15min_launchd_err.log</string>
</dict>
</plist>
